  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "preinstall": "node scripts/check-package-manager.mjs",
    "dev": "vite",
    "dev:cn": "vite --mode cn",
    "build": "vue-tsc -b && vite build",
    "build:cn": "vue-tsc -b && vite build --mode cn --outDir dist-zh",
