# Loaded by every build and the dev server, and the reference for all options.

# API base URL (no trailing slash). Required for building.
# VITE_API_BASE=https://api.example.com/station/api/v2

# Dev server only: where a relative VITE_API_BASE is forwarded (a local backend
# or a remote api endpoint).
# DEV_PROXY_TARGET=http://127.0.0.1:8888

# Public address of the site
# VITE_SITE_URL=https://station.example.com

# Ship only this language file (path from the frontend folder, named after its
# language: ja.json, zh-Hans.json, zh-Hant.json or en.json).
# VITE_LOCALE_FILE=src/i18n/locales/cn/zh-Hans.json

# One About page (Markdown, path from the frontend folder) for every language
# this build ships.
# VITE_ABOUT_FILE=src/assets/about_cn.md

# Sidebar footer. {version} is replaced with package.json's version at build
# time, "\n" starts a new line (also in hosting dashboard values), empty: no footer.
VITE_FOOTER="v{version} Dev Build"

# Preset filter chips in the settings panel, comma-separated
VITE_PRESET_TAGS=🦐,エビ
